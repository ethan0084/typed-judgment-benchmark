    "score": "tsx --import ./scripts/cli-resolve-register.mjs scripts/score-run.mjs",
    "inspect": "tsx --import ./scripts/cli-resolve-register.mjs scripts/inspect-run.mjs"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
