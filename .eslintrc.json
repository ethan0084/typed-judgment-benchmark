{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "node": true,
    "es2022": true,
    "browser": true
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "dist/",
    "runs/",
    "*.config.mjs",
    "next-env.d.ts"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "MemberExpression[object.type='MemberExpression'][object.object.name='process'][object.property.name='env']",
        "message": "Read secrets only through src/server/env.ts, never process.env directly."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/server/env.ts"
      ],
      "rules": {
        "no-restricted-syntax": "off"
      }
    }
  ]
}